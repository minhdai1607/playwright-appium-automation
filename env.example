# Environment Configuration
# Copy file này thành .env và điền thông tin của bạn

# Môi trường: local | stg | prod
ENV=local

# Appium Server
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# Test Settings
HEADLESS=false
TIMEOUT=30000
DEBUG=false

# Test User Credentials
TEST_USERNAME=testuser@example.com
TEST_PASSWORD=Test@123


